# Backend runtime
NODE_ENV=development
DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@<pooler-host>:5432/postgres
PORT=5000
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
FRONTEND_URL=http://localhost:5173

# Copy the Session Pooler URI for this project from Supabase Connect.

# Server-only Supabase Storage credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
SUPABASE_STORAGE_BUCKET=voter-documents

# Used only when intentionally running create-admin.js
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ALLOW_ADMIN_SEED=false
